# Copy to deploy/.env and fill in.
DOMAIN=outlook.example.org         # DNS A record -> the EC2 public IP; "localhost" for a local test
S3_BUCKET=agclimateaf-953975492473-af-south-1-an
S3_PREFIX=published
AWS_REGION=af-south-1
# Optional: CloudFront in front of s3://$S3_BUCKET/published. Empty = the API serves layer files.
PUBLIC_DATA_URL=
# Seconds before latest.json / runs.json are re-read from S3 (new runs appear within this time).
INDEX_TTL=300
# Local folder instead of S3 (development): DATA_DIR=/data and mount it in docker-compose.yml
# DATA_DIR=/data
